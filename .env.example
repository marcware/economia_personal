# Copia este fichero a .env (gitignored) y rellena tus credenciales reales.
# Se obtienen en el Control Panel de Enable Banking (enablebanking.com) al dar de alta la app.
ENABLEBANKING_APPLICATION_ID=
ENABLEBANKING_PRIVATE_KEY_PATH=secrets/enablebanking_private_key.pem

# Bit2Me (cripto): API key de SOLO LECTURA creada en Bit2Me > Ajustes > API.
# El secret solo se muestra una vez al crearla.
BIT2ME_API_KEY=
BIT2ME_API_SECRET=
